# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# geodata sources — large HOTOSM/HDX downloads, re-fetchable (see data/sources/README.md)
/data/sources/hotosm_rou_waterways_osm_geojson.zip
/data/sources/waterways.geojson
/data/sources/hotosm_rou_waterways_osm_gpkg.zip
/data/sources/README.txt
/data/sources/config.yaml
/data/sources/metadata.json

# geocoding pipeline — SQLite cache (rebuilt by scripts/geocode_batch.py)
/data/cache/

# python bytecode + venv
__pycache__/
*.pyc
.venv/

# geocoding pipeline — Natural Earth supplement (downloaded by geocode_batch.py)
/data/sources/ne_10m_rivers_europe.geojson

data/rivers_osm.geojson
data/matched_small_geocoded.geojson
data/raw/overpass_water_all.json
data/raw/overpass_water_all.json
data/raw/overpass_water_polys.json

# P0 §4.3: geocoding intermediates — regenerated by the pipeline, must NOT ship
# to the client (attach_geometry.py reads the CANONICAL copy from data/, not
# public/). waters_geocoded.geojson is rebuilt by merge_geocoded.py +
# sources/geocoder.mjs; waters.geojson is a stale derived export.
/public/data/waters_geocoded.geojson
/public/data/waters.geojson
/public/data/reciprocity.json

# e2e screenshots
.e2e/

# playwright artifacts (e2e suite — regenerated per run, never committed)
test-results/
playwright-report/
blob-report/
test-results/

# F6 PWA (t_0618943a): Serwist build artifacts — generated at build time by
# @serwist/next from src/app/sw.ts; never committed (offline-pwa-feasibility.md §3).
public/sw.js
public/sw.js.map
public/swe-worker*.js

# F6 data freshness — generated by scripts/gen-meta.mjs during prebuild
# (git log -- public/data = deployed data source of truth). Present in every
# built/CI artifact via the prebuild hook.
public/data/meta.json

# URL validation reports are generated evidence, not source data
/data/processed/link_validation_report.json
/data/processed/link_validation_repairs.jsonl

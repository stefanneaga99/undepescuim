/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# geodata sources — large HOTOSM/HDX downloads, re-fetchable (see data/sources/README.md)
/data/sources/hotosm_rou_waterways_osm_geojson.zip
/data/sources/waterways.geojson
/data/sources/hotosm_rou_waterways_osm_gpkg.zip
/data/sources/README.txt
/data/sources/config.yaml
/data/sources/metadata.json

# geocoding pipeline — SQLite cache (rebuilt by scripts/geocode_batch.py)
/data/cache/

# python bytecode + venv
__pycache__/
*.pyc
.venv/

# geocoding pipeline — Natural Earth supplement (downloaded by geocode_batch.py)
/data/sources/ne_10m_rivers_europe.geojson

data/rivers_osm.geojson
data/matched_small_geocoded.geojson
data/raw/overpass_water_all.json
data/raw/overpass_water_all.json
data/raw/overpass_water_polys.json

